// Stage 2 settings of oist/LuscombeU_Selenoproteins_Pipeline (release 0.2.0), used by every stage 2 run except
// "default" (stage2/run/run.sh adds it).
process {
    withName: SELENOPROFILES_SELENOPROFILES {
        // 3' sequences of 2,000 nt after each prediction: the length of the windows on which the 20-bit threshold of
        // the Oikopleura SECIS model was set (Selenoprofiles default: 6,000 nt). The rest as in the pipeline.
        ext.args = { (meta.domain in ['bacteria', 'archaea'] ? '-no_splice ' : '') + '-three_prime_length 2000' }
    }
}
