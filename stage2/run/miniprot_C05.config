// Test variant of the stage 2 settings (run "eval_miniprot"): miniprot splice signals weighted by 0.5 instead of 1
// (-C), so that exons at non-canonical introns such as GA-AG (9 % of O. dioica introns; Denoeud et al. 2010) cost less.
process {
    withName: MINIPROT_ALIGN {
        ext.args = '-I --gff -C 0.5'
    }
}
