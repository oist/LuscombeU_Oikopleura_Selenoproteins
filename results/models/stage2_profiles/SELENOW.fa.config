name = SELENOW
queries = all
blast_filtering = x.evalue < 1 and x.sequence_identity_in_range(281, 413) >= 0.12
p2g_filtering = ( len(x.protein()) >60 or x.coverage()> 0.2 ) and x.sequence_identity_in_range(281, 413) >= 0.15
p2g_refiltering = x.label!='pseudo'
tags = ['Selenoprotein[\\- ,]*W', 'selW', '[^P]sePW', 'Selenoprotein[\\- ,]*V', 'selV', 'sePV', 'selenoprotein domain']
blast_options = SELENO
exonerate_options = SELENO
genewise_options = SELENO

