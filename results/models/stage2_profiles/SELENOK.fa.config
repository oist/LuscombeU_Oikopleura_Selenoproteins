name = SELENOK
queries = all
blast_filtering = x.evalue < 0.01 and not x.target_sequence_is_repetitive() and not x.alignment_is_repetitive()
p2g_refiltering = x.sequence_identity_with_profile()>=0.12
max_blast_hits = STRICT
tags = ['Selenoprotein[\\- ]?K', ' selK ', 'Selenoprotein[\\- ]?G', ' selG ', ' SePK ', ' SePG ']
blast_options = SELENO
exonerate_options = SELENO
genewise_options = SELENO

