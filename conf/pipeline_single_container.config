// Run every process of oist/LuscombeU_Selenoproteins_Pipeline in the image built from this repository's
// environment.yml, instead of the image declared by each module.
//   nextflow run oist/LuscombeU_Selenoproteins_Pipeline -r <release> -profile <profile> \
//       -c conf/pipeline_single_container.config --input ... --outdir ...
// A process selector in a configuration file takes precedence over the container directive of the modules.
// Keep the two addresses identical to those in scripts/run_in_container.sh.
process {
    withName: '.*' {
        container = { workflow.containerEngine in ['singularity', 'apptainer']
            ? 'PLACEHOLDER_SINGULARITY_IMAGE_URL'
            : 'PLACEHOLDER_DOCKER_IMAGE' }
    }
}
